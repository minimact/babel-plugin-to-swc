{
  "version": "1.0",
  "plugin": {
    "name": "simple-babel-plugin",
    "description": "Simplified test plugin for babel-to-swc transpiler"
  },

  "structs": {
    "Component": {
      "description": "Represents a React component",
      "fields": {
        "name": { "type": "String", "required": true },
        "props": { "type": "Vec<Prop>", "default": "vec![]" },
        "hooks": { "type": "Vec<Hook>", "default": "vec![]" },
        "jsx_elements": { "type": "Vec<JsxElement>", "default": "vec![]" },
        "local_variables": { "type": "Vec<Variable>", "default": "vec![]" },
        "helper_functions": { "type": "Vec<HelperFunc>", "default": "vec![]" }
      }
    },

    "Prop": {
      "description": "Component prop information",
      "fields": {
        "name": { "type": "String", "required": true },
        "has_default": { "type": "bool", "default": "false" },
        "has_type_annotation": { "type": "bool", "default": "false" },
        "csharp_type": { "type": "String", "default": "\"object\".to_string()" }
      }
    },

    "Hook": {
      "description": "React hook information",
      "fields": {
        "hook_type": { "type": "String", "required": true },
        "state_name": { "type": "String", "required": true },
        "setter_name": { "type": "String", "required": true },
        "initial_value": { "type": "String", "default": "\"undefined\".to_string()" }
      }
    },

    "JsxElement": {
      "description": "JSX element information",
      "fields": {
        "tag_name": { "type": "String", "required": true },
        "is_self_closing": { "type": "bool", "default": "false" }
      }
    },

    "Variable": {
      "description": "Local variable information",
      "fields": {
        "name": { "type": "String", "required": true },
        "has_initializer": { "type": "bool", "default": "false" }
      }
    },

    "HelperFunc": {
      "description": "Helper function information",
      "fields": {
        "name": { "type": "String", "required": true }
      }
    },

    "TypeMap": {
      "description": "Type mapping for TypeScript to C# type conversion",
      "fields": {
        "decimal": { "type": "&'static str", "default": "\"decimal\"" },
        "int": { "type": "&'static str", "default": "\"int\"" },
        "string": { "type": "&'static str", "default": "\"string\"" },
        "bool": { "type": "&'static str", "default": "\"bool\"" }
      }
    },

    "AttrInfo": {
      "description": "JSX attribute information",
      "fields": {
        "name": { "type": "String", "required": true },
        "value": { "type": "String", "required": true },
        "is_expression": { "type": "bool", "default": "false" }
      }
    }
  },

  "functions": {
    "processComponent": {
      "description": "Process a component function - extract hooks, props, JSX",
      "params": [
        { "name": "path", "type": "&str" },
        { "name": "state", "type": "&str" },
        { "name": "name", "type": "&str" }
      ],
      "returns": "String",
      "uses_string_builder": true
    },

    "extractProps": {
      "description": "Extract props from component parameters",
      "params": [
        { "name": "path", "type": "&str" }
      ],
      "returns": "Vec<Prop>"
    },

    "extractUseState": {
      "description": "Extract useState hook information",
      "params": [
        { "name": "call_path", "type": "&str" }
      ],
      "returns": "Option<Hook>"
    },

    "extractAttributes": {
      "description": "Extract JSX attributes",
      "params": [
        { "name": "attributes", "type": "&[JSXAttrOrSpread]" }
      ],
      "returns": "Vec<AttrInfo>"
    },

    "getAttributeValue": {
      "description": "Get attribute value as string",
      "params": [
        { "name": "value", "type": "Option<&JSXAttrValue>" }
      ],
      "returns": "String"
    },

    "getInitialValueString": {
      "description": "Get initial value as string",
      "params": [
        { "name": "node", "type": "Option<&Expr>" }
      ],
      "returns": "String"
    },

    "tsTypeToCSharpType": {
      "description": "Convert TypeScript type to C# type",
      "params": [
        { "name": "ts_type", "type": "&TsType" }
      ],
      "returns": "String",
      "requires_pattern_matching": true
    },

    "inferType": {
      "description": "Infer C# type from JavaScript value",
      "params": [
        { "name": "node", "type": "&Expr" }
      ],
      "returns": "&'static str",
      "requires_pattern_matching": true
    },

    "formatProperty": {
      "description": "Format a C# property declaration",
      "params": [
        { "name": "name", "type": "&str" },
        { "name": "type", "type": "&str" },
        { "name": "value", "type": "&str" }
      ],
      "returns": "String",
      "uses_string_builder": true
    },

    "generateJSX": {
      "description": "Generate JSX code from element",
      "params": [
        { "name": "element", "type": "&JsxElement" }
      ],
      "returns": "String"
    }
  },

  "babel_to_swc_mappings": {
    "path.node": "node",
    "path.parent.type": "parent_type",
    "t.isIdentifier(node)": "matches!(node, Expr::Ident(_))",
    "t.isObjectPattern(node)": "matches!(node, Pat::Object(_))",

    "t.isTSStringKeyword(tsType)": "matches!(ts_type, TsType::TsKeywordType(TsKeywordType { kind: TsKeywordTypeKind::TsStringKeyword, .. }))",
    "t.isTSNumberKeyword(tsType)": "matches!(ts_type, TsType::TsKeywordType(TsKeywordType { kind: TsKeywordTypeKind::TsNumberKeyword, .. }))",
    "t.isTSBooleanKeyword(tsType)": "matches!(ts_type, TsType::TsKeywordType(TsKeywordType { kind: TsKeywordTypeKind::TsBooleanKeyword, .. }))",
    "t.isTSAnyKeyword(tsType)": "matches!(ts_type, TsType::TsKeywordType(TsKeywordType { kind: TsKeywordTypeKind::TsAnyKeyword, .. }))",
    "t.isTSArrayType(tsType)": "matches!(ts_type, TsType::TsArrayType(_))",
    "t.isTSTypeLiteral(tsType)": "matches!(ts_type, TsType::TsTypeLit(_))",
    "t.isTSTypeReference(tsType)": "matches!(ts_type, TsType::TsTypeRef(_))",
    "t.isIdentifier(tsType.typeName)": "matches!(type_ref.type_name, TsEntityName::Ident(_))",
    "tsType.typeName.name": "type_name_ident.sym.to_string()",
    "tsType.elementType": "array_type.elem_type",
    "!tsType": "ts_type.is_none()",
    "tsType.is_empty()": "false",

    "t.isStringLiteral(value)": "matches!(value, JSXAttrValue::Lit(ref lit) if matches!(lit, Lit::Str(_)))",
    "t.isJSXExpressionContainer(value)": "matches!(value, JSXAttrValue::JSXExprContainer(_))",
    "t.isIdentifier(value.expression)": "matches!(jsx_expr_container.expr, JSXExpr::Expr(ref expr) if matches!(&**expr, Expr::Ident(_)))",
    "t.isMemberExpression(value.expression)": "matches!(jsx_expr_container.expr, JSXExpr::Expr(ref expr) if matches!(&**expr, Expr::Member(_)))",
    "t.isCallExpression(value.expression)": "matches!(jsx_expr_container.expr, JSXExpr::Expr(ref expr) if matches!(&**expr, Expr::Call(_)))",
    "t.isStringLiteral(node)": "matches!(node, Expr::Lit(Lit::Str(_)))",
    "t.isNumericLiteral(node)": "matches!(node, Expr::Lit(Lit::Num(_)))",
    "t.isBooleanLiteral(node)": "matches!(node, Expr::Lit(Lit::Bool(_)))",
    "t.isNullLiteral(node)": "matches!(node, Expr::Lit(Lit::Null(_)))",
    "t.isArrayExpression(node)": "matches!(node, Expr::Array(_))",
    "t.isObjectExpression(node)": "matches!(node, Expr::Object(_))",
    "!node": "node.is_none()",
    "!value": "value.is_none()",
    "node.is_empty()": "false",
    "value.is_empty()": "value.is_none()",

    "callPath": "call_path",
    "varPath": "var_path",
    "funcPath": "func_path",
    "jsxPath": "jsx_path",
    "componentName": "component_name",
    "openingElement": "opening_element",
    "varInfo": "var_info",
    "elemName": "elem_name",
    "elementName": "element_name",
    "stateId": "state_id",
    "setStateId": "set_state_id",
    "typeName": "type_name",
    "typeMap": "type_map",
    "attrInfo": "attr_info",
    "firstParam": "first_param",
    "elementType": "element_type",
    "Number.isInteger(value)": "value.fract() == 0.0",
    "node.value": "num_lit.value",
    "typeMap[typeName]": "type_map.get(type_name.as_str())",

    "value.value": "str_lit.value",
    "value.expression": "jsx_expr_container.expr",
    "value.expression.name": "ident.sym",
    "node.value": "num_lit.value",
    "node.elements": "array_expr.elems",
    "node.properties": "obj_expr.props",
    "element.tagName": "element.tag_name",
    "tagName": "tag_name"
  },

  "enum_patterns": {
    "JSXAttrValue": {
      "Lit": {
        "pattern": "JSXAttrValue::Lit(ref lit)",
        "inner_type": "Lit"
      },
      "JSXExprContainer": {
        "pattern": "JSXAttrValue::JSXExprContainer(ref jsx_expr_container)",
        "inner_type": "JSXExprContainer"
      }
    },
    "Expr": {
      "Lit": {
        "pattern": "Expr::Lit(ref lit)",
        "inner_type": "Lit",
        "variants": {
          "Str": {
            "pattern": "Lit::Str(ref str_lit)",
            "fields": ["value", "span"]
          },
          "Num": {
            "pattern": "Lit::Num(ref num_lit)",
            "fields": ["value", "span"]
          }
        }
      },
      "Ident": {
        "pattern": "Expr::Ident(ref ident)",
        "fields": ["sym", "span"]
      },
      "Member": {
        "pattern": "Expr::Member(ref member_expr)",
        "fields": ["obj", "prop"]
      },
      "Call": {
        "pattern": "Expr::Call(ref call_expr)",
        "fields": ["callee", "args"]
      },
      "Array": {
        "pattern": "Expr::Array(ref array_expr)",
        "fields": ["elems", "span"]
      }
    }
  },

  "code_generation_hints": {
    "variables_needing_declaration": [
      "code",
      "call_path",
      "var_path",
      "func_path",
      "jsx_path",
      "expr",
      "state_id",
      "set_state_id",
      "node",
      "attr",
      "prop"
    ],
    "path_traverse_variables": {
      "CallExpression": "call_path",
      "VariableDeclaration": "var_path",
      "FunctionDeclaration": "func_path",
      "JSXElement": "jsx_path"
    },
    "skip_helper_generation": [
      "processComponent",
      "extractUseState",
      "extractProps",
      "extractAttributes",
      "tsTypeToCSharpType",
      "inferType"
    ]
  }
}
