  "babel_source": "function tsTypeToCSharpType(tsType) {\r\n  if (!tsType) return 'dynamic';\r\n\r\n  switch (tsType.type) {\r\n    case 'TSStringKeyword':\r\n      return 'string';\r\n    case 'TSNumberKeyword':\r\n      return 'double';\r\n    case 'TSBooleanKeyword':\r\n      return 'bool';\r\n    case 'TSVoidKeyword':\r\n      return 'void';\r\n    case 'TSAnyKeyword':\r\n      return 'dynamic';\r\n    case 'TSArrayType':\r\n      const elementType = tsTypeToCSharpType(tsType.elementType);\r\n      return `List<${elementType}>`;\r\n    default:\r\n      return 'dynamic';\r\n  }\r\n}",
