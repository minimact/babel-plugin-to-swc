  "rust_translation": "fn extract_expression_template(expr: &Expr, component: &mut Component, path: &str) -> Option<ExpressionTemplate> {\n    // Skip if it's a simple identifier (no transformation)\n    if matches!(expr, Expr::Ident(_)) {\n        return None;\n    }\n\n    // Skip conditionals (handled by structural templates)\n    if matches!(expr, Expr::Cond(_) | Expr::Bin(BinExpr { op: BinaryOp::LogicalAnd | BinaryOp::LogicalOr, .. })) {\n        return None;\n    }\n\n    // Method call: price.toFixed(2)\n    if let Expr::Call(call_expr) = expr {\n        if let Callee::Expr(callee) = &call_expr.callee {\n            if matches!(**callee, Expr::Member(_)) {\n                return extract_method_call_template(call_expr, component, path);\n            }\n        }\n    }\n\n    // Binary expression: count * 2 + 1\n    if let Expr::Bin(bin_expr) = expr {\n        return extract_binary_expression_template(bin_expr, component, path);\n    }\n\n    // Member expression: user.name, items.length\n    if let Expr::Member(member_expr) = expr {\n        return extract_member_expression_template(member_expr, component, path);\n    }\n\n    // Unary expression: -count, +value\n    if let Expr::Unary(unary_expr) = expr {\n        return extract_unary_expression_template(unary_expr, component, path);\n    }\n\n    None\n}",
