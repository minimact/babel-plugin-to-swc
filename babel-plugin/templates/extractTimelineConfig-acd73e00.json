{
  "type": "FunctionDeclaration",
  "name": "extractTimelineConfig",
  "params": [
    {
      "name": "config",
      "inferredType": "&Options",
      "defaultValue": null
    },
    {
      "name": "timeline",
      "inferredType": "unknown",
      "defaultValue": null
    }
  ],
  "inferredReturnType": "Option<T>",
  "babel_source": "function extractTimelineConfig(config, timeline) {\r\n  config.properties.forEach(prop => {\r\n    if (t.isObjectProperty(prop) && t.isIdentifier(prop.key)) {\r\n      const key = prop.key.name;\r\n      const value = prop.value;\r\n\r\n      switch (key) {\r\n        case 'duration':\r\n          if (t.isNumericLiteral(value)) {\r\n            timeline.duration = value.value;\r\n          }\r\n          break;\r\n        case 'repeat':\r\n          if (t.isBooleanLiteral(value)) {\r\n            timeline.repeat = value.value;\r\n          }\r\n          break;\r\n        case 'repeatCount':\r\n          if (t.isNumericLiteral(value)) {\r\n            timeline.repeatCount = value.value;\r\n          }\r\n          break;\r\n        case 'easing':\r\n          if (t.isStringLiteral(value)) {\r\n            timeline.easing = value.value;\r\n          }\r\n          break;\r\n        case 'autoPlay':\r\n          if (t.isBooleanLiteral(value)) {\r\n            timeline.autoPlay = value.value;\r\n          }\r\n          break;\r\n      }\r\n    }\r\n  });\r\n\r\n  console.log(`[Timeline] Config: duration=${timeline.duration}ms, repeat=${timeline.repeat}, easing=${timeline.easing}`);\r\n}",
