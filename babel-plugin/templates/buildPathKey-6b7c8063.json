  "rust_translation": "pub fn build_path_key(tag_name: &str, index: usize, parent_path: &[usize]) -> String {\n    let mut parent_keys: Vec<String> = Vec::new();\n    \n    // Build parent path from indices\n    for i in 0..parent_path.len() {\n        parent_keys.push(format!(\"[{}]\", parent_path[i]));\n    }\n    \n    let result = format!(\"{}.{}[{}]\", parent_keys.join(\".\"), tag_name, index);\n    result.trim_start_matches('.').to_string()\n}",
