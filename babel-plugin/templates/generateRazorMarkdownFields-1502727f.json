  "babel_source": "function generateRazorMarkdownFields(component, lines) {\r\n  if (component.useRazorMarkdown) {\r\n    for (const md of component.useRazorMarkdown) {\r\n      lines.push(`    [RazorMarkdown]`);\r\n      lines.push(`    [State]`);\r\n      lines.push(`    private string ${md.name} = null!;`);\r\n      lines.push('');\r\n    }\r\n  }\r\n}",
