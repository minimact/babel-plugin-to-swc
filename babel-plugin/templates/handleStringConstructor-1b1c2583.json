  "babel_source": "function handleStringConstructor(node, generateCSharpExpression) {\r\n  if (!t.isIdentifier(node.callee, { name: 'String' })) {\r\n    return null;\r\n  }\r\n  if (node.arguments.length > 0) {\r\n    const arg = generateCSharpExpression(node.arguments[0]);\r\n    return `(${arg}).ToString()`;\r\n  }\r\n  return '\"\"';\r\n}",
