  "rust_translation": "pub fn build_member_path(expr: &Expr) -> Option<String> {\n    let mut parts: Vec<String> = Vec::new();\n    let mut current = expr;\n\n    while let Expr::Member(member_expr) = current {\n        if let MemberProp::Ident(ident) = &member_expr.prop {\n            parts.insert(0, ident.sym.to_string());\n        }\n        current = &*member_expr.obj;\n    }\n\n    if let Expr::Ident(ident) = current {\n        parts.insert(0, ident.sym.to_string());\n    }\n\n    if !parts.is_empty() {\n        Some(parts.join(\".\"))\n    } else {\n        None\n    }\n}",
