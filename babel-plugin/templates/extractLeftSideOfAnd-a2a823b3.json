  "rust_translation": "fn extract_left_side_of_and<'a>(expr: &'a Expr) -> &'a Expr {\n    // Check if it's a logical && expression\n    let bin_expr = match expr {\n        Expr::Bin(bin) if bin.op == BinaryOp::LogicalAnd => bin,\n        _ => return expr,\n    };\n\n    let right = &*bin_expr.right;\n\n    // If right is JSX, left is the condition\n    if matches!(right, Expr::JSXElement(_) | Expr::JSXFragment(_)) {\n        return &*bin_expr.left;\n    }\n\n    // Otherwise, return the expression as-is\n    expr\n}",
