  "rust_translation": "fn extract_use_signalr(&mut self, call_expr: &CallExpr, component: &mut Component) {\n    // Get parent context - must be a VarDeclarator\n    let signalr_name = match self.get_parent() {\n        Some(ParentContext::VarDeclarator(name)) => name.clone(),\n        _ => return,\n    };\n\n    // Get arguments\n    let hub_url = call_expr.args.get(0).map(|arg| &*arg.expr);\n    let on_message = call_expr.args.get(1).map(|arg| &*arg.expr);\n\n    // Extract hub URL if it's a string literal\n    let hub_url_value = hub_url.and_then(|e| match e {\n        Expr::Lit(Lit::Str(s)) => Some(s.value.to_string()),\n        _ => None,\n    });\n\n    component.use_signalr.push(UseSignalRInfo {\n        name: signalr_name,\n        hub_url: hub_url_value,\n        has_on_message: on_message.is_some(),\n    });\n}",
