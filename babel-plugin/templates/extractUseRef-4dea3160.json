  "rust_translation": "fn extract_use_ref(&mut self, call_expr: &CallExpr, component: &mut Component) {\n    // Get parent context - must be a VarDeclarator\n    let ref_name = match self.get_parent() {\n        Some(ParentContext::VarDeclarator(name)) => name.clone(),\n        _ => return,\n    };\n\n    // Get initial value from first argument\n    let initial_value = call_expr.args.get(0).map(|arg| &*arg.expr);\n\n    component.use_ref.push(UseRefInfo {\n        name: ref_name,\n        initial_value: self.generate_csharp_expression(initial_value),\n    });\n}",
