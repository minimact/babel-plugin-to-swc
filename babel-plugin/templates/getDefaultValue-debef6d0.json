  "rust_translation": "pub fn get_default_value(csharp_type: &str) -> String {\n    // Handle List types\n    if csharp_type.starts_with(\"List<\") {\n        return format!(\"new {}()\", csharp_type);\n    }\n\n    match csharp_type {\n        \"int\" => \"0\".to_string(),\n        \"bool\" => \"false\".to_string(),\n        \"string\" => \"\\\"\\\"\".to_string(),\n        \"dynamic\" | \"object\" => \"null\".to_string(),\n        _ => \"null\".to_string()\n    }\n}",
