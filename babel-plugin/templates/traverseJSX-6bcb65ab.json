  "rust_translation": "fn traverse_jsx(\n    node: &JSXElement,\n    path: Vec<usize>,\n    component: &Component,\n    expression_templates: &mut Vec<ExpressionTemplate>,\n) {\n    // Check children for expressions\n    for (i, child) in node.children.iter().enumerate() {\n        match child {\n            JSXElementChild::JSXExprContainer(container) => {\n                let mut new_path = path.clone();\n                new_path.push(i);\n                if let Some(template) = extract_expression_template(&container.expr, component, new_path) {\n                    expression_templates.push(template);\n                }\n            }\n            JSXElementChild::JSXElement(element) => {\n                let mut new_path = path.clone();\n                new_path.push(i);\n                traverse_jsx(element, new_path, component, expression_templates);\n            }\n            _ => {}\n        }\n    }\n\n    // Check attributes for expressions\n    for attr in &node.opening.attrs {\n        if let JSXAttrOrSpread::JSXAttr(jsx_attr) = attr {\n            if let Some(JSXAttrValue::JSXExprContainer(container)) = &jsx_attr.value {\n                if let Some(mut template) = extract_expression_template(&container.expr, component, path.clone()) {\n                    if let JSXAttrName::Ident(ident) = &jsx_attr.name {\n                        template.attribute = Some(ident.sym.to_string());\n                    }\n                    expression_templates.push(template);\n                }\n            }\n        }\n    }\n}",
