{
  "type": "FunctionDeclaration",
  "name": "generateVNodeRepresentation",
  "params": [
    {
      "name": "node",
      "inferredType": "&Node",
      "defaultValue": null
    },
    {
      "name": "path",
      "inferredType": "&Path",
