  "babel_source": "function buildAttributePathKey(tagName, index, parentPath, attrName) {\r\n  const parentKeys = [];\r\n  for (let i = 0; i < parentPath.length; i++) {\r\n    parentKeys.push(`[${parentPath[i]}]`);\r\n  }\r\n  return `${parentKeys.join('.')}.${tagName}[${index}].@${attrName}`.replace(/^\\./, '');\r\n}",
