  "babel_source": "function transpileTemplateLiteral(expr) {\r\n  let result = '$\"';\r\n\r\n  for (let i = 0; i < expr.quasis.length; i++) {\r\n    result += expr.quasis[i].value.cooked;\r\n\r\n    if (i < expr.expressions.length) {\r\n      result += `{${transpileExpression(expr.expressions[i])}}`;\r\n    }\r\n  }\r\n\r\n  result += '\"';\r\n  return result;\r\n}",
