  "rust_translation": "pub fn convert_string_to_bool(csharp_test: &str, original_test_node: &Expr) -> String {\n    // If it's already a boolean expression, return as-is\n    let is_boolean_expr = match original_test_node {\n        Expr::Bin(_) => true,\n        Expr::Unary(UnaryExpr { op: UnaryOp::Bang, .. }) => true,\n        _ => false,\n    };\n\n    if is_boolean_expr {\n        return csharp_test.to_string();\n    }\n\n    // For any other expression, wrap with ToBool() helper\n    format!(\"MinimactHelpers.ToBool({})\", csharp_test)\n}",
