  "babel_source": "function extractLiteralValue(node) {\r\n    if (t.isStringLiteral(node)) {\r\n      return node.value;\r\n    } else if (t.isNumericLiteral(node)) {\r\n      return node.value.toString();\r\n    } else if (t.isBooleanLiteral(node)) {\r\n      return node.value.toString();\r\n    } else {\r\n      return null;\r\n    }\r\n  }",
